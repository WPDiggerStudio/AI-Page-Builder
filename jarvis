use Symfony\Component\Console\Input\ArgvInput;
use Symfony\Component\Console\Output\ConsoleOutput;
use WPJarvis\Framework\Application;
use WPJarvis\Framework\Support\AppRegistry;
use WPJarvis\Framework\Contracts\Console\Kernel as KernelContract;

// ===============================================================================
// WP-CLI Integration Mode
// ===============================================================================

if (defined('WP_CLI') && WP_CLI) {
    WP_CLI::add_command('jarvis', function ($args, $assoc_args) {
        // We need to determine WHICH plugin's app to run.
        // For now, we'll try to find an app that matches the current directory
        // or just use the first registered one.

        $currentDir = getcwd();
        $targetApp = null;

        foreach (AppRegistry::all() as $app) {
            if (str_starts_with($currentDir, $app->basePath())) {
                $targetApp = $app;
                break;
            }
        }

        if (!$targetApp) {
            // Fallback: use first available
            $apps = AppRegistry::all();
            if (!empty($apps)) {
                $targetApp = reset($apps);
            }
        }

        if (!$targetApp) {
            WP_CLI::error("No active WP Jarvis application found. Make sure the plugin is active.");
            return;
        }

        $kernel = $targetApp->make(KernelContract::class);

        // Convert WP-CLI args back to argv format for Symfony Console
        // This is a simplification; a robust bridge is better but complex.
        // Simple shim:
        $argv = ['jarvis', ...$args];
        foreach ($assoc_args as $key => $value) {
            $argv[] = "--{$key}={$value}";
        }

        $input = new ArgvInput($argv);
        $output = new ConsoleOutput();

        $kernel->handle($input, $output);
    });
    return;
}

// ===============================================================================
// Standalone Mode (php jarvis)
// ===============================================================================

if (PHP_SAPI !== 'cli') {
    fwrite(STDERR, "❌ This script must be run from the command line.\n");
    exit(1);
}

// Define CLI constant for application awareness
define('WPJARVIS_CLI', true);

// ===============================================================================
// Environment Configuration
// ===============================================================================

// Configure essential server globals for WordPress CLI compatibility
$_SERVER = array_merge($_SERVER, [
    'SERVER_NAME'    => 'localhost',
    'HTTP_HOST'      => 'localhost',
    'REQUEST_METHOD' => 'GET',
    'REQUEST_URI'    => '/',
    'SCRIPT_NAME'    => '/index.php',
    'REMOTE_ADDR'    => '127.0.0.1',
    'SERVER_PORT'    => 80,
    'HTTPS'          => 'off',
    'REQUEST_SCHEME' => $_SERVER['REQUEST_SCHEME']
        ?? (($_SERVER['HTTPS'] ?? '') === 'on' ? 'https' : 'http'),
]);

// Disable themes for CLI operations
define('WP_USE_THEMES', false);

// ===============================================================================
// WordPress Core Bootstrap
// ===============================================================================

// Locate WordPress core - try multiple possible locations
$wpLoadPaths = [
    __DIR__ . '/../../../wp-load.php',      // Standard: wp-content/plugins/plugin-name
    __DIR__ . '/../../../../wp-load.php',   // Nested structure
    dirname(__DIR__, 4) . '/wp-load.php',   // Alternative calculation
    getcwd() . '/wp-load.php',              // Current working directory
];

$wpLoadPath = null;
foreach ($wpLoadPaths as $path) {
    if (file_exists($path)) {
        $wpLoadPath = $path;
        break;
    }
}

if ($wpLoadPath === null) {
    // Fallback: If no WP found, we might just be generating code.
    // Try to load just composer autoload if present.
    $autoloadPaths = [
        __DIR__ . '/vendor/autoload.php',
        __DIR__ . '/../vendor/autoload.php',
        dirname(__DIR__) . '/vendor/autoload.php',
    ];

    $autoloadFile = null;
    foreach ($autoloadPaths as $path) {
        if (file_exists($path)) {
            $autoloadFile = $path;
            break;
        }
    }

    if ($autoloadFile) {
        require_once $autoloadFile;
        // Proceed without WP (some commands might fail)
    } else {
        fwrite(STDERR, sprintf(
            "❌ Error: Could not locate WordPress core or Composer autoload.\n"
        ));
        exit(1);
    }
} else {
    // Load WordPress core
    require_once $wpLoadPath;
}

// ===============================================================================
// Dynamic Environment Adjustment
// ===============================================================================

// Enhance globals using actual WordPress configuration after wp-load
if (function_exists('home_url')) {
    $siteUrl = parse_url(home_url());
    if ($siteUrl) {
        $_SERVER['SERVER_NAME'] = $siteUrl['host'] ?? $_SERVER['SERVER_NAME'];
        $_SERVER['HTTP_HOST']   = $siteUrl['host'] ?? $_SERVER['HTTP_HOST'];
        $_SERVER['REQUEST_URI'] = $siteUrl['path'] ?? $_SERVER['REQUEST_URI'];
        $_SERVER['HTTPS']       = ($siteUrl['scheme'] ?? 'http') === 'https' ? 'on' : 'off';
    }
}

// ===============================================================================
// Composer Autoloader (Ensure loaded if WP didn't load plugin)
// ===============================================================================

// Determine possible locations of autoload file
$autoloadPaths = [
    __DIR__ . '/vendor/autoload.php',
    __DIR__ . '/../vendor/autoload.php',
    dirname(__DIR__) . '/vendor/autoload.php',
];

$autoloadFile = null;
foreach ($autoloadPaths as $path) {
    if (file_exists($path)) {
        $autoloadFile = $path;
        break;
    }
}

if ($autoloadFile && !class_exists(Application::class)) {
    require_once $autoloadFile;
}

// ===============================================================================
// Load Environment Variables
// ===============================================================================

if (class_exists(\Dotenv\Dotenv::class) && file_exists(__DIR__ . '/.env')) {
    $dotenv = \Dotenv\Dotenv::createImmutable(__DIR__);
    $dotenv->safeLoad();
}

// ===============================================================================
// Application Bootstrap
// ===============================================================================

try {
    // Define plugin constants from .env values
    $prefix = env('PLUGIN_PREFIX', 'APP');

    if (!defined('WPJARVIS_DIR')) {
        define('WPJARVIS_DIR', __DIR__);
    }
    if (!defined('WPJARVIS_FILE')) {
        define('WPJARVIS_FILE', __DIR__ . '/plugin.php');
    }
    if (!defined('WPJARVIS_BASENAME')) {
        define('WPJARVIS_BASENAME', plugin_basename(WPJARVIS_FILE));
    }
    if (!defined('WPJARVIS_VERSION')) {
        define('WPJARVIS_VERSION', env('PLUGIN_VERSION', '1.0.0'));
    }

    // Define prefixed constants
    defined("{$prefix}_VERSION")  || define("{$prefix}_VERSION", env('PLUGIN_VERSION', '1.0.0'));
    defined("{$prefix}_FILE")     || define("{$prefix}_FILE", WPJARVIS_FILE);
    defined("{$prefix}_DIR")      || define("{$prefix}_DIR", WPJARVIS_DIR);
    defined("{$prefix}_BASENAME") || define("{$prefix}_BASENAME", WPJARVIS_BASENAME);
    defined("{$prefix}_SLUG")     || define("{$prefix}_SLUG", env('PLUGIN_SLUG', 'wp-jarvis'));

    /**
     * Create and bootstrap the application instance
     */
    $app = new Application(WPJARVIS_DIR);

    // Register in registry
    $slug = env('PLUGIN_SLUG', 'wp-jarvis');
    AppRegistry::register($slug, $app);
    // Set current app context for Facades
    if (!defined('WPJARVIS_CURRENT_APP_KEY')) {
        define('WPJARVIS_CURRENT_APP_KEY', $slug);
    }

    /**
     * Bind plugin-specific paths and constants
     */
    $app->instance('plugin.prefix', $prefix);
    $app->instance('plugin.basename', WPJARVIS_BASENAME);
    $app->instance('plugin.file', WPJARVIS_FILE);
    $app->instance('plugin.dir', WPJARVIS_DIR);
    $app->instance('plugin.version', env('PLUGIN_VERSION', '1.0.0'));
    $app->instance('plugin.slug', $slug);
    $app->instance('plugin.name', env('PLUGIN_NAME', 'WP Jarvis App'));

    /**
     * Create and run the console kernel
     */
    $kernel = $app->make(\WPJarvis\Framework\Contracts\Console\Kernel::class);

    $input = new ArgvInput();
    $output = new ConsoleOutput();

    // Display branding banner and list commands if no command is provided
    $command = $input->getFirstArgument();
    $showBranding = empty($command) || $command === 'list';

    if ($showBranding && !$input->hasParameterOption(['--quiet', '-q', '--no-ansi'])) {
        $kernel->displayBanner($output);
        $kernel->listCommands($output);
        exit(0);
    }

    $status = $kernel->handle($input, $output);

    // Terminate application
    $kernel->terminate($input, $status);

    exit($status);

} catch (Throwable $e) {
    fwrite(STDERR, sprintf(
        "\n<fg=red>❌ Error:</> %s\n\n" .
        "<fg=yellow>File:</> %s:%d\n\n" .
        "<fg=yellow>Trace:</>\n%s\n",
        $e->getMessage(),
        $e->getFile(),
        $e->getLine(),
        $e->getTraceAsString()
    ));
    exit(1);
}
