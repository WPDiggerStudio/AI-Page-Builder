#--------------------------------------------------------------------------
# Plugin Configuration
#--------------------------------------------------------------------------
# IMPORTANT: Change these values for each plugin - this is the ONLY place
# you need to modify when creating a new plugin!

PLUGIN_PREFIX=BRA
PLUGIN_VERSION=1.0.0
PLUGIN_SLUG=bra-calculator
PLUGIN_NAME="BRA Calculator"
PLUGIN_TEXTDOMAIN=bra-calculator
PLUGIN_NAMESPACE=BraCalculator\App
PLUGIN_REST_NAMESPACE=bra-calculator/v1

# Storage folder name (under wp-content/uploads/)
PLUGIN_STORAGE_FOLDER=bra-calculator

#--------------------------------------------------------------------------
# Application Settings
#--------------------------------------------------------------------------
APP_NAME="${PLUGIN_NAME}"
APP_ENV=local
APP_KEY=base64:WD8rdRGs46n03O3lhfAdkOswIA2HZ39vdCkbnIUIxGQ=
APP_DEBUG=true
APP_URL=http://localhost
APP_LOCALE=en

#--------------------------------------------------------------------------
# Logging
#--------------------------------------------------------------------------
LOG_CHANNEL=single
LOG_LEVEL=debug

#--------------------------------------------------------------------------
# Cache & Queue
#--------------------------------------------------------------------------
CACHE_DRIVER=file
QUEUE_CONNECTION=sync
SESSION_DRIVER=file

#--------------------------------------------------------------------------
# Cleanup on Uninstall
#--------------------------------------------------------------------------
CLEAN_ON_UNINSTALL=false
