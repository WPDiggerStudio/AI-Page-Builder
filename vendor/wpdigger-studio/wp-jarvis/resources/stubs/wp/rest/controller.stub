<?php

declare(strict_types=1);

namespace {{ namespace }};

use WP_REST_Request;
use WP_REST_Response;
use WPJarvis\Framework\WP\REST\Controller as BaseController;

/**
 * {{ class }}
 */
class {{ class }} extends BaseController
{
    protected string $namespace = '{{ namespace_slug }}/v1';
    protected string $rest_base = '{{ rest_base }}';

    public function register_routes(): void
    {
        register_rest_route($this->namespace, '/' . $this->rest_base, [
            [
                'methods' => 'GET',
                'callback' => [$this, 'index'],
                'permission_callback' => [$this, 'canRead'],
            ],
            [
                'methods' => 'POST',
                'callback' => [$this, 'store'],
                'permission_callback' => [$this, 'canCreate'],
            ],
        ]);

        register_rest_route($this->namespace, '/' . $this->rest_base . '/(?P<id>\d+)', [
            [
                'methods' => 'GET',
                'callback' => [$this, 'show'],
                'permission_callback' => [$this, 'canRead'],
            ],
            [
                'methods' => 'PUT,PATCH',
                'callback' => [$this, 'update'],
                'permission_callback' => [$this, 'canUpdate'],
            ],
            [
                'methods' => 'DELETE',
                'callback' => [$this, 'destroy'],
                'permission_callback' => [$this, 'canDelete'],
            ],
        ]);
    }

    public function index(WP_REST_Request $request): WP_REST_Response
    {
        return new WP_REST_Response(['data' => []], 200);
    }

    public function show(WP_REST_Request $request): WP_REST_Response
    {
        $id = (int) $request->get_param('id');
        return new WP_REST_Response(['data' => ['id' => $id]], 200);
    }

    public function store(WP_REST_Request $request): WP_REST_Response
    {
        return new WP_REST_Response(['data' => []], 201);
    }

    public function update(WP_REST_Request $request): WP_REST_Response
    {
        $id = (int) $request->get_param('id');
        return new WP_REST_Response(['data' => ['id' => $id]], 200);
    }

    public function destroy(WP_REST_Request $request): WP_REST_Response
    {
        return new WP_REST_Response(null, 204);
    }

    public function canRead(): bool
    {
        return true;
    }

    public function canCreate(): bool
    {
        return current_user_can('edit_posts');
    }

    public function canUpdate(): bool
    {
        return current_user_can('edit_posts');
    }

    public function canDelete(): bool
    {
        return current_user_can('delete_posts');
    }
}
