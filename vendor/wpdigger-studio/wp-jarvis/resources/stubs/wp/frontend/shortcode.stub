<?php

declare( strict_types=1 );

namespace {{ namespace }};

use WPJarvis\Framework\WP\Frontend\Shortcode\AbstractShortcode;

/**
 * {{ class }} Shortcode
 *
 * Provides [{{ shortcode_tag }}] shortcode functionality.
 *
 * Usage:
 *   [{{ shortcode_tag }} title="Hello World"]
 *   {{ shortcode_with_content }}
 *
 * @package {{ namespace }}
 */
class {{ class }} extends AbstractShortcode {
	/**
	 * The shortcode tag.
	 */
	protected static string $tag = '{{ shortcode_tag }}';

	/**
	 * Whether shortcode allows content between opening/closing tags.
	 */
	protected bool $allowContent = {{ allow_content }};

	/**
	 * Define shortcode fields.
	 *
	 * Uses the same structure as Metabox::fields() for consistency.
	 * Each field: type, id, label, and optional description/options.
	 *
	 * Supported types:
	 * - text: Basic text input
	 * - textarea: Multi-line text
	 * - wysiwyg: HTML content (WYSIWYG editor)
	 * - number: Numeric input with optional min/max
	 * - checkbox: True/false toggle
	 * - select: Dropdown with predefined options
	 * - color: Hex color picker
	 * - image: Media library selection
	 * - url: URL input
	 * - email: Email input
	 *
	 * @return array<int, array<string, mixed>> Array of field definitions.
	 */
	protected function fields(): array {
		return [
			[
				'type'        => 'text',
				'id'          => 'id',
				'label'       => __( 'CSS ID', '{{ textdomain }}' ),
				'description' => __( 'CSS ID for the wrapper element.', '{{ textdomain }}' ),
			],
			[
				'type'        => 'text',
				'id'          => 'class',
				'label'       => __( 'CSS Classes', '{{ textdomain }}' ),
				'description' => __( 'Additional CSS classes.', '{{ textdomain }}' ),
			],
{{ field_definitions }}
		];
	}

	/**
	 * Render the shortcode output.
	 *
	 * @param array<string, mixed> $atts Sanitized attributes.
	 * @param string|null $content Processed content (if allowed).
	 *
	 * @return string Rendered HTML.
	 */
	public function render( array $atts, ?string $content = null ): string {
		// Build CSS classes
		$classes = [ '{{ shortcode_tag }}-shortcode' ];
		if ( ! empty( $atts['class'] ) ) {
			$classes[] = esc_attr( $atts['class'] );
		}

		// Build wrapper attributes
		$wrapperAtts = [
			'class' => implode( ' ', $classes ),
		];
		if ( ! empty( $atts['id'] ) ) {
			$wrapperAtts['id'] = esc_attr( $atts['id'] );
		}

		// Build attribute string
		$attrString = '';
		foreach ( $wrapperAtts as $key => $value ) {
			$attrString .= sprintf( ' %s="%s"', $key, $value );
		}

		// Start output
		$output = '<div' . $attrString . '>';

		// Title
		if ( ! empty( $atts['title'] ) ) {
			$output .= '<h3 class="{{ shortcode_tag }}-title">' . esc_html( $atts['title'] ) . '</h3>';
		}

		// Content (if allowed and provided)
		if ( $content !== null ) {
			$output .= '<div class="{{ shortcode_tag }}-content">';
			$output .= $content;
			$output .= '</div>';
		}

		// TODO: Add your custom rendering logic here

		$output .= '</div>';

		return $output;

		// Alternative: Use a template file
		// return $this->view('{{ shortcode_tag }}', [
		//     'atts' => $atts,
		//     'content' => $content,
		// ]);
	}

	/**
	 * Enqueue assets for this shortcode.
	 *
	 * Called only when the shortcode is actually used on the page.
	 *
	 * @return void
	 */
	public function enqueueAssets(): void {
		// Uncomment and modify as needed:
		// wp_enqueue_style(
		//     '{{ shortcode_tag }}-style',
		//     plugin_dir_url(__FILE__) . '../../../resources/css/{{ shortcode_tag }}.css',
		//     [],
		//     '1.0.0'
		// );
		//
		// wp_enqueue_script(
		//     '{{ shortcode_tag }}-script',
		//     plugin_dir_url(__FILE__) . '../../../resources/js/{{ shortcode_tag }}.js',
		//     ['jquery'],
		//     '1.0.0',
		//     true
		// );
	}

	/**
	 * Get metadata for adapters (Elementor, WPBakery, TinyMCE).
	 *
	 * @return array<string, mixed>
	 */
	public function getMetadata(): array {
		return [
			'tag'         => static::$tag,
			'title'       => __( '{{ title }}', '{{ textdomain }}' ),
			'description' => __( '{{ description }}', '{{ textdomain }}' ),
			'icon'        => 'shortcode',
			'category'    => 'general',
			'keywords'    => [ '{{ shortcode_tag }}', 'shortcode' ],
		];
	}
}
